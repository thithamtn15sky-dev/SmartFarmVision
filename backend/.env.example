# Mẫu cấu hình cho backend SmartFarm Vision.
# Chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env - nó chứa mật khẩu cơ sở dữ liệu.

# ---- Bắt buộc ----

# Cổng máy chủ Node.js. Ứng dụng Flutter mặc định gọi vào cổng này.
PORT=3000

# Chuỗi kết nối MongoDB Atlas, lấy ở Atlas > Database > Connect > Drivers.
# Tên cơ sở dữ liệu phải nằm trong chuỗi (ở đây là SmartFarmData), vì mã nguồn
# dùng db mặc định của chuỗi kết nối chứ không chỉ định riêng.
MONGODB_URI=mongodb+srv://<tên_người_dùng>:<mật_khẩu>@<cụm>.mongodb.net/SmartFarmData?retryWrites=true&w=majority

# ---- Hai dịch vụ mô hình chạy cục bộ ----

# Máy chủ llama.cpp nạp Qwen3-VL, dùng để nhìn ảnh và sinh câu trả lời.
# Bật bằng: ./start_vlm.sh     (mặc định cổng 8081)
VLM_SERVER_URL=http://127.0.0.1:8081

# Máy chủ Python sinh vector và xếp hạng lại, phục vụ truy xuất RAG.
# Bật bằng: python scripts/embedding_server.py     (mặc định cổng 8082)
EMBED_SERVER_URL=http://127.0.0.1:8082

# ---- Tuỳ chọn ----

# Bật truy xuất RAG bằng vector và BM25 + reranker. Đặt false để chạy đường cũ
# (chỉ tra cứu tất định theo nhãn bệnh), hữu ích khi so sánh hoặc khi chưa bật
# máy chủ embedding.
USE_VECTOR_RAG=true

# Thành phố lấy dữ liệu thời tiết cho màn hình trang trại.
FARM_CITY=Ho Chi Minh

# ---- Tham số truy xuất (để trống là dùng cấu hình đã đánh giá ở chương 5) ----

# Số triệu chứng lấy ra ở chặng 1 để thu hẹp tập bệnh.
SYMPTOM_TOP_K=3
# Số tài liệu phác đồ đưa vào ngữ cảnh ở chặng 2.
KNOWLEDGE_TOP_K=5
# Số ứng viên BM25 đưa cho reranker chấm lại.
RERANK_CANDIDATE_K=20
# Ngưỡng điểm tương đồng tối thiểu của triệu chứng. Để 0 = tắt; thực nghiệm cho
# thấy điểm của câu có triệu chứng và câu không liên quan chồng lấn nhau nên
# không có ngưỡng nào cắt được (chi tiết trong services/vectorRetrieval.js).
SYMPTOM_MIN_SCORE=0
